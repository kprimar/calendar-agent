# Copy this file to .env and fill in values as needed.
# credentials.json and token.json are loaded from the credentials/ folder —
# you do not need to put secrets in this file.

# Anthropic API key for Claude email classification
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Your timezone for new calendar events (e.g. America/New_York, America/Chicago, America/Los_Angeles)
CALENDAR_TIMEZONE=America/New_York

# Optional: override log level (DEBUG, INFO, WARNING)
LOG_LEVEL=INFO

# Google Calendar ID to create/manage events on (defaults to primary)
# Find your calendar ID in Google Calendar settings → your calendar → "Integrate calendar"
CALENDAR_ID=primary
